{
  "name": "@antonsoloviev/stoicheia",
  "version": "0.1.0",
  "private": true,
  "description": "Read Euclid I.1–20 and investigate I.22 in Greek, Latin and English with interactive constructions.",
  "type": "module",
  "author": "Anton Soloviev <anton@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/stoicheia.git"
  },
  "homepage": "https://antonsoo.github.io/stoicheia/",
  "keywords": [
    "euclid",
    "geometry",
    "ancient-greek",
    "latin",
    "education",
    "constructions"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4327 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4327 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:oracle": "node --import tsx scripts/oracle-cases.ts | python3 scripts/circle-oracle.py",
    "test:browser": "node scripts/browser-check.mjs",
    "test:dev": "node scripts/quickstart-check.mjs",
    "verify:triangles": "node --import tsx scripts/triangle-cases.ts | python3 scripts/triangle-oracle.py",
    "verify:bisections": "node --import tsx scripts/bisection-cases.ts | python3 scripts/bisection-oracle.py",
    "verify:cases": "node --import tsx scripts/casebook-cases.ts | python3 scripts/casebook-oracle.py",
    "verify:right-angles": "node --import tsx scripts/right-angle-cases.ts | python3 scripts/right-angle-oracle.py",
    "verify:inequalities": "node --import tsx scripts/inequality-cases.ts | python3 scripts/inequality-oracle.py",
    "test:inequalities": "node scripts/inequality-browser.mjs",
    "verify:closure": "node --import tsx scripts/closure-cases.ts | python3 scripts/closure-oracle.py",
    "test:closure": "node scripts/closure-browser.mjs",
    "test:closure-upgrade": "node scripts/closure-upgrade.mjs",
    "verify:closure-print": "node --import tsx scripts/closure-print.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

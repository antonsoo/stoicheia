{
  "name": "@antonsoloviev/stoicheia",
  "version": "0.1.0",
  "private": true,
  "description": "Read Euclid, Archimedes and Pappus in Greek, Latin and English with working geometry and original printed pages.",
  "type": "module",
  "author": "Anton Soloviev <anton@praviel.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonsoo/stoicheia.git"
  },
  "homepage": "https://antonsoo.github.io/stoicheia/",
  "keywords": [
    "euclid",
    "geometry",
    "ancient-greek",
    "latin",
    "education",
    "constructions",
    "archimedes",
    "circles",
    "horn-angle",
    "pappus",
    "quadratrix"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4327 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4327 --strictPort",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:oracle": "node --import tsx scripts/oracle-cases.ts | python3 scripts/circle-oracle.py",
    "test:browser": "node scripts/browser-check.mjs",
    "test:dev": "node scripts/quickstart-check.mjs",
    "verify:triangles": "node --import tsx scripts/triangle-cases.ts | python3 scripts/triangle-oracle.py",
    "verify:bisections": "node --import tsx scripts/bisection-cases.ts | python3 scripts/bisection-oracle.py",
    "verify:cases": "node --import tsx scripts/casebook-cases.ts | python3 scripts/casebook-oracle.py",
    "verify:right-angles": "node --import tsx scripts/right-angle-cases.ts | python3 scripts/right-angle-oracle.py",
    "verify:inequalities": "node --import tsx scripts/inequality-cases.ts | python3 scripts/inequality-oracle.py",
    "test:inequalities": "node scripts/inequality-browser.mjs",
    "verify:closure": "node --import tsx scripts/closure-cases.ts | python3 scripts/closure-oracle.py",
    "test:closure": "node scripts/closure-browser.mjs",
    "test:closure-upgrade": "node scripts/closure-upgrade.mjs",
    "verify:closure-print": "node --import tsx scripts/closure-print.ts",
    "verify:nested": "node --import tsx scripts/nested-cases.ts | python3 scripts/nested-oracle.py",
    "test:nested": "node scripts/nested-browser.mjs",
    "test:illustrated": "node scripts/illustrated-browser.mjs",
    "verify:quadrature": "node --import tsx scripts/quadrature-cases.ts | python3 scripts/quadrature-oracle.py",
    "test:quadrature": "node scripts/quadrature-browser.mjs",
    "verify:gnomon": "node --import tsx scripts/gnomon-cases.ts | python3 scripts/gnomon-oracle.py",
    "test:gnomon": "node scripts/gnomon-browser.mjs",
    "verify:mesolabe": "node --import tsx scripts/mesolabe-cases.ts | python3 scripts/mesolabe-oracle.py",
    "test:mesolabe": "node scripts/mesolabe-browser.mjs",
    "test:desk": "node scripts/desk-browser.mjs",
    "test:desk-upgrade": "node scripts/desk-upgrade.mjs",
    "verify:measure": "node --import tsx scripts/measure-cases.ts | python3 scripts/measure-oracle.py",
    "verify:measure-sources": "python3 scripts/measure-sources.py",
    "test:measure": "node scripts/measure-browser.mjs",
    "test:measure-upgrade": "node scripts/measure-upgrade.mjs",
    "verify:copying": "node --import tsx scripts/copying-cases.ts | python3 scripts/copying-oracle.py",
    "test:copying": "node scripts/copying-browser.mjs",
    "verify:circle-bounds": "node --import tsx scripts/circle-cases.ts | python3 scripts/circle-bounds-oracle.py",
    "verify:circle-sources": "python3 scripts/circle-sources.py",
    "test:circle": "node scripts/circle-browser.mjs",
    "verify:circle-print": "python3 scripts/circle-print.py",
    "test:circle-upgrade": "node scripts/circle-upgrade.mjs",
    "verify:horn": "node --import tsx scripts/horn-cases.ts | python3 scripts/horn-oracle.py",
    "verify:horn-sources": "python3 scripts/horn-sources.py",
    "test:horn": "node scripts/horn-browser.mjs",
    "verify:horn-print": "python3 scripts/horn-print.py",
    "verify:quadratrix": "node --import tsx scripts/quadratrix-cases.ts | python3 scripts/quadratrix-oracle.py",
    "verify:quadratrix-sources": "python3 scripts/quadratrix-sources.py",
    "test:quadratrix": "node scripts/quadratrix-browser.mjs",
    "test:quadratrix-upgrade": "node scripts/quadratrix-upgrade.mjs",
    "verify:ratios": "node --import tsx scripts/ratios-cases.ts | python3 scripts/ratios-oracle.py",
    "verify:ratios-sources": "python3 scripts/ratios-sources.py",
    "test:ratios": "node scripts/ratios-browser.mjs",
    "verify:solids": "node --import tsx scripts/solids-cases.ts | python3 scripts/solids-oracle.py",
    "verify:solids-sources": "python3 scripts/solids-sources.py",
    "test:solids": "node scripts/solids-browser.mjs",
    "verify:solids-files": "python3 scripts/solids-artifacts.py",
    "verify:primes": "node --import tsx scripts/primes-cases.ts | python3 scripts/primes-oracle.py",
    "verify:primes-sources": "python3 scripts/primes-sources.py",
    "test:primes": "node scripts/primes-browser.mjs",
    "verify:primes-files": "python3 scripts/primes-artifacts.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.19.2",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

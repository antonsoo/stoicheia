/URI (data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22297mm%22%20height%3D%22210mm%22%20viewBox%3D%220%200%20297%20210%22%20role%3D%22img%22%3E%3Ctitle%3EMesolabe%20paper%20exploration%3A%202%20times%20the%20volume%3C%2Ftitle%3E%3Cdesc%3EPrint%20landscape%20at%20actual%20size%2C%20verify%20the%2025%20millimetre%20bar%2C%20cut%20the%20two%20lower%20squares%2C%20and%20place%20them%20in%20the%20upper%20frame.%20Keep%20the%20middle%20square%20fixed.%20Left%20plate%20goes%20above%20it%2C%20right%20below.%20Physical%20fabrication%20and%20printer%20scaling%20are%20unverified.%3C%2Fdesc%3E%3Cstyle%3Etext%7Bfont%3A3.3px%20sans-serif%3Bfill%3A%23193d60%7Dpath%2Cline%2Crect%7Bfill%3Anone%3Bstroke%3A%23193d60%3Bstroke-width%3A.3%7D%20.cut%7Bstroke-dasharray%3A2%201%7D.diag%7Bstroke-width%3A.5%7D.rule%7Bstroke%3A%23a84b29%3Bstroke-width%3A.6%7D%3C%2Fstyle%3E%3Ctext%20x%3D%2215%22%20y%3D%2212%22%20style%3D%22font-size%3A5px%22%3ESTOICHEIA%20%2F%20SLIDING%20PLATES%20%2F%20VOLUME%20FACTOR%202%3C%2Ftext%3E%3Ctext%20x%3D%2215%22%20y%3D%2219%22%3EA%20modern%20paper%20exploration%20of%20the%20construction%20transmitted%20by%20Eutocius%2C%20Heiberg%201881%2C%20pp.106-113.%3C%2Ftext%3E%3Cpath%20d%3D%22M15%2030H230M15%2090H230%22%2F%3E%3Crect%20x%3D%2290%22%20y%3D%2230%22%20width%3D%2260%22%20height%3D%2260%22%2F%3E%3Cpath%20class%3D%22diag%22%20d%3D%22M90%2030L150%2090%22%2F%3E%3Ctext%20x%3D%22120%22%20y%3D%2242%22%3EFIXED%3C%2Ftext%3E%3Ctext%20x%3D%22120%22%20y%3D%2248%22%3EMIDDLE%3C%2Ftext%3E%3Ctext%20x%3D%22118%22%20y%3D%2255%22%3E60%20x%2060%20mm%3C%2Ftext%3E%3Ctext%20x%3D%2215%22%20y%3D%22100%22%3EHold%20both%20moving%20panels%20between%20the%20guides.%20All%20diagonals%20slope%20the%20same%20way.%3C%2Ftext%3E%3Ctext%20x%3D%2215%22%20y%3D%22106%22%3EAlign%20a%20straightedge%20from%20A%20through%20both%20exposed%20contacts%20B%2C%20G%20to%20D.%20Read%20G's%20height%20above%20the%20lower%20guide.%3C%2Ftext%3E%3Ctext%20x%3D%2215%22%20y%3D%22112%22%3EFor%20an%20original%20edge%20of%201%20unit%2C%20divide%20that%20height%20by%2030%20mm.%20Cube%20this%20ratio%20to%20check%20the%20volume.%3C%2Ftext%3E%3Crect%20class%3D%22cut%22%20x%3D%2230%22%20y%3D%22120%22%20width%3D%2260%22%20height%3D%2260%22%2F%3E%3Cpath%20class%3D%22diag%22%20d%3D%22M30%20120L90%20180%22%2F%3E%3Ctext%20x%3D%2233%22%20y%3D%22128%22%3EA%3C%2Ftext%3E%3Ctext%20x%3D%2233%22%20y%3D%22157%22%3ELEFT%20%2F%20above%20middle%3C%2Ftext%3E%3Ctext%20x%3D%2233%22%20y%3D%22174%22%3EE%3C%2Ftext%3E%3Ctext%20x%3D%2284%22%20y%3D%22176%22%3EZ%3C%2Ftext%3E%3Crect%20class%3D%22cut%22%20x%3D%22150%22%20y%3D%22120%22%20width%3D%2260%22%20height%3D%2260%22%2F%3E%3Cpath%20class%3D%22diag%22%20d%3D%22M150%20120L210%20180%22%2F%3E%3Ctext%20x%3D%22154%22%20y%3D%22151%22%3ERIGHT%3C%2Ftext%3E%3Ctext%20x%3D%22154%22%20y%3D%22157%22%3Ebelow%20middle%3C%2Ftext%3E%3Cpath%20class%3D%22rule%22%20d%3D%22M206%20150h8%22%2F%3E%3Ctext%20x%3D%22202%22%20y%3D%22148%22%3ED%3C%2Ftext%3E%3Ctext%20x%3D%22203%22%20y%3D%22177%22%3ET%3C%2Ftext%3E%3Cpath%20d%3D%22M242%20155v3m0-1.5h25m0-1.5v3%22%2F%3E%3Ctext%20x%3D%22242%22%20y%3D%22164%22%3E25%20mm%20calibration%3C%2Ftext%3E%3Ctext%20x%3D%2215%22%20y%3D%22193%22%3ECut%20dashed%20outlines%20only.%20Make%20a%20slit%20at%20the%20middle%20panel's%20upper%20and%20lower%20edges%20if%20needed%20to%20pass%20the%20right%20panel%20below%20it.%3C%2Ftext%3E%3Ctext%20x%3D%2215%22%20y%3D%22199%22%3EPrint%20at%20100%25%2C%20without%20fit-to-page.%20This%20is%20not%20a%20groove%20fabrication%20plan%3B%20physical%20assembly%20and%20accuracy%20are%20unverified.%3C%2Ftext%3E%3Cmetadata%3EMIT%2C%20Anton%20Soloviev%2C%202026.%20Source%3A%20https%3A%2F%2Fwww.wilbourhall.org%2Fpdfs%2FArchimedes_VOL_III.pdf.%20Equal%20squares%20and%2060%20mm%20dimensions%20are%20modern%20choices.%3C%2Fmetadata%3E%3C%2Fsvg%3E)>>>>
endobj
